# SCOUTJOBS Production Environment Variables
# Self-hosted WSL2 deployment
# Copy to .env.production and fill in actual values
# NEVER commit .env.production to version control

# Environment
SCOUT_ENV=production
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# PostgreSQL
POSTGRES_DB=scoutjobs
POSTGRES_USER=scoutjobs
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Database URL (constructed from above)
DATABASE_URL=postgresql+psycopg://scoutjobs:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/scoutjobs

# Valkey/Redis
REDIS_URL=redis://valkey:6379/0

# CORS (comma-separated exact origins)
CORS_ORIGINS=https://scout.apexora.workers.dev

# Optional, comma-separated ADDITIONAL origins allowed alongside CORS_ORIGINS.
# Only for temporarily testing against a Quick Tunnel trycloudflare.com URL
# (see docs/QUICK_TUNNEL_TESTING.md) -- leave blank in normal operation.
# Never use "*" here.
CORS_EXTRA_ORIGINS=

# Cloudflare Tunnel
# Leave blank until the named tunnel "scout-backend" has been created in
# Cloudflare Zero Trust -> Networks -> Tunnels. The core backend (postgres,
# valkey, api, linkedin_worker) starts and runs fully without this set --
# only `start_backend.ps1 -IncludeTunnel` requires it.
# NOTE: the free Quick Tunnel test mode (`-IncludeQuickTunnel`) needs NO
# token at all -- do not add a "QUICK_TUNNEL_TOKEN" variable, none exists.
CLOUDFLARE_TUNNEL_TOKEN=
TRUST_CF_CONNECTING_IP=true

# LinkedIn Worker
LINKEDIN_JOB_TIMEOUT_SECONDS=1200
SEARCH_STALE_AFTER_SECONDS=1800

# Cache TTLs (seconds)
SEARCH_CACHE_TTL_SECONDS=90
DETAIL_CACHE_TTL_SECONDS=1800

# Rate Limits (per minute/IP)
RATE_LIMIT_SEARCH_PER_MINUTE=10
RATE_LIMIT_POLL_PER_MINUTE=60
RATE_LIMIT_DETAIL_PER_MINUTE=20

# Database Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Backup (optional)
BACKUP_DIR=/mnt/e/ScoutJobsBackups/PostgreSQL
BACKUP_RETENTION_DAYS=14
SECONDARY_BACKUP_DIR=

# Self-host mode
PRODUCTION_HOST_MODE=wsl2

# Application
APP_VERSION=2.0.0
GIT_SHA=unknown
