# SCOUTJOBS Render environment variables (placeholders only).
#
# Non-secret values below are also declared directly in render.yaml.
# DATABASE_URL and REDIS_URL are secrets: enter them in the Render dashboard
# (or `render env` CLI) -- never commit real values.
# NEVER commit a file containing real credentials.

SCOUT_ENV=production
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false
APP_VERSION=2.0.0

# Neon PostgreSQL connection string (psycopg3 driver, TLS required).
# postgresql:// and postgres:// are also accepted -- the app normalizes the
# scheme to postgresql+psycopg:// automatically without touching the rest
# of the URL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@NEON_HOST/DB?sslmode=require

# Upstash Redis native TLS connection string. Used for the RQ queue, the
# search/detail cache, and rate limiting -- rediss:// (TLS) must be kept as-is.
REDIS_URL=rediss://default:PASSWORD@UPSTASH_HOST:6379

# Exact Cloudflare Workers Static Assets origin -- no wildcard in production.
CORS_ORIGINS=https://scout.apexora.workers.dev

LINKEDIN_JOB_TIMEOUT_SECONDS=1200
SEARCH_STALE_AFTER_SECONDS=1800
SEARCH_CACHE_TTL_SECONDS=90
DETAIL_CACHE_TTL_SECONDS=1800

RATE_LIMIT_SEARCH_PER_MINUTE=10
RATE_LIMIT_POLL_PER_MINUTE=60
RATE_LIMIT_DETAIL_PER_MINUTE=20

# Conservative pooling for a 512MB free-tier container + serverless Neon.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
